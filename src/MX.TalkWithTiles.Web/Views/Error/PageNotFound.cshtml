<style type="text/css">
    * { transition: all 0.6s; }

    html { height: 100%; }

    body {
        color: #888;
        font-family: 'Lato', sans-serif;
        margin: 0;
    }

    #main {
        display: table;
        height: 100vh;
        text-align: center;
        width: 100%;
    }

    .fof {
        display: table-cell;
        vertical-align: middle;
    }

    .fof h1 {
        animation: type .5s alternate infinite;
        display: inline-block;
        font-size: 50px;
        padding-right: 12px;
    }


    @@keyframes type {
        from { box-shadow: inset -3px 0 0 #888; }

        to { box-shadow: inset -3px 0 0 transparent; }
    }
</style>


<div id="main">
    <div class="fof">
        <h1>Looks like that doesn't exist!</h1>
        <h2>The page you were trying to access does not exist, return home by clicking <a asp-controller="Home" asp-action="Index">here.</a></h2>

        <h2>If you believe this is incorrect contact the administration team at admin@talkwithtiles.com</h2>

    </div>
</div>