@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

@if (Model.ShowExceptionDetail)
{
    <div class="alert alert-danger mt-3">
        <h4>Exception Details</h4>
        @if (!string.IsNullOrEmpty(Model.ExceptionPath))
        {
            <p><strong>Path:</strong> <code>@Model.ExceptionPath</code></p>
        }
        <p><strong>Exception:</strong></p>
        <pre><code>@Model.ExceptionMessage</code></pre>
        @if (!string.IsNullOrEmpty(Model.ExceptionStackTrace))
        {
            <p><strong>Stack Trace:</strong></p>
            <pre><code>@Model.ExceptionStackTrace</code></pre>
        }
    </div>
}

<h3>Oops! Something went wrong!</h3>

<p>Unfortunately things go wrong from time to time - it's just something we have to deal with. Hopefully it doesn't happen too often though!</p>

<p>If you retry the action you were attempting and the issue persists then please use the @Html.ActionLink("feedback", "Feedback", "Home") form on the site and give us the above request ID and a description of what you were trying to do.</p>

<p>Sorry for any inconvenience caused!</p>