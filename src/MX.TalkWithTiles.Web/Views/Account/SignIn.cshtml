@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-2">Sign In</h2>
                <p class="text-muted text-center mb-4">Choose a provider to sign in to Talk With Tiles</p>

                <div class="d-grid gap-3">
                    <a href="@Url.Action("SignInMicrosoft", "Account", new { returnUrl })"
                       class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" class="me-2">
                            <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                            <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                            <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                            <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                        </svg>
                        Continue with Microsoft
                    </a>

                    @* Add more providers here in the future, e.g.: *@
                    @* <a href="@Url.Action("SignInGoogle", "Account", new { returnUrl })"
                       class="btn btn-outline-dark btn-lg d-flex align-items-center justify-content-center">
                        <i class="fab fa-google me-2"></i>
                        Continue with Google
                    </a> *@
                </div>

                <hr class="my-4" />
                <p class="text-muted text-center small mb-0">
                    By signing in, you agree to our
                    <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>.
                </p>
            </div>
        </div>
    </div>
</div>
