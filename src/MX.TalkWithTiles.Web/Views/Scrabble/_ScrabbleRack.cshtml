@using MX.TalkWithTiles.Web.Extensions
@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel

<div class="row">

    <div class="scrabbleRackContainer">

        @if (Model.ShowRemainingTiles(User))
        {
            <div class="scrabbleRackControls">
                <button class="btn btn-primary" data-toggle="modal" data-target="#remainingTilesModal" type="button">
                    <image id="bagImage" src="/img/bag.svg" width="20px" height="20px">
                        <span>@Model.BagStateModel.Tiles.Count</span>
                    </image>
                </button>
            </div>
        }

        @if (Model.ShowRemainingTileCountOnly())
        {
            <div class="scrabbleRackControls">
                <button class="btn btn-primary" type="button" title="You can only see the remaining tile count for this game">
                    <image id="bagImage" src="/img/bag.svg" width="20px" height="20px">
                        <span>@Model.BagStateModel.Tiles.Count</span>
                    </image>
                </button>
            </div>
        }

        <div id="scrabbleRack" class="scrabbleRack">
            <div id="rack_0" class="scrabbleRackCell"></div>
            <div id="rack_1" class="scrabbleRackCell"></div>
            <div id="rack_2" class="scrabbleRackCell"></div>
            <div id="rack_3" class="scrabbleRackCell"></div>
            <div id="rack_4" class="scrabbleRackCell"></div>
            <div id="rack_5" class="scrabbleRackCell"></div>
            <div id="rack_6" class="scrabbleRackCell"></div>
            <div id="rack_7" class="scrabbleRackCell"></div>
        </div>

        <div class="scrabbleRackControls">
            <button id="recallTiles" class="btn btn-primary" title="Recall your tiles from the board">
                <i class="fas fa-arrow-down"></i>
            </button>
            <button id="shuffleTiles" class="btn btn-primary" title="Shuffle your tiles in the rack (this will also recall your tiles)">
                <i class="fas fa-random"></i>
            </button>
        </div>
    </div>

</div>

<div class="row">

    <div id="selectedTileMessage" class="selectedTileMessage" style="display: none;">
        <label>You have selected a tile - click/tap on an available space on the rack or board to place the tile.</label>
    </div>

</div>