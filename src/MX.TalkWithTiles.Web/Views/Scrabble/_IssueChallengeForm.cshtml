@using MX.TalkWithTiles.Contracts.Constants
@model MX.TalkWithTiles.Web.Models.IssueChallengeModel

<form asp-action="SubmitChallenge">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="GameId" type="hidden"/>
    <div class="form-group">
        <label asp-for="GameChallengeReason" class="control-label"></label>
        <select asp-for="GameChallengeReason" asp-items="@Html.GetEnumSelectList<GameChallengeReason>()" class="form-control"></select>
        <span asp-validation-for="GameChallengeReason" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ChallengeText" class="control-label"></label>
        <textarea asp-for="ChallengeText" class="form-control" rows="10"></textarea>
        <span asp-validation-for="ChallengeText" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Submit Challenge" class="btn btn-primary"/>
    </div>
</form>