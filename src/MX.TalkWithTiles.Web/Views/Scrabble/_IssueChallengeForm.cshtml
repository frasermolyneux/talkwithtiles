@using MX.TalkWithTiles.Contracts.Constants
@model MX.TalkWithTiles.Web.Models.IssueChallengeModel

<form asp-action="SubmitChallenge">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input asp-for="GameId" type="hidden"/>
    <div class="mb-3">
        <label asp-for="GameChallengeReason" class="form-label"></label>
        <select asp-for="GameChallengeReason" asp-items="@Html.GetEnumSelectList<GameChallengeReason>()" class="form-select"></select>
        <span asp-validation-for="GameChallengeReason" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ChallengeText" class="form-label"></label>
        <textarea asp-for="ChallengeText" class="form-control" rows="10"></textarea>
        <span asp-validation-for="ChallengeText" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary"><i class="fas fa-flag me-1"></i>Submit Challenge</button>
    </div>
</form>