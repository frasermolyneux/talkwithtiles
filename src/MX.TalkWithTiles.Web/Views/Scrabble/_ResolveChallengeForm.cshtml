@using ChallengeResult = MX.TalkWithTiles.Contracts.Constants.GameChallengeResult
@model ResolveChallengeModel

<form asp-action="ResolveChallenge" asp-antiforgery="true">
    <input type="hidden" asp-for="Id"/>
    <input type="hidden" asp-for="Accept"/>

    <div class="d-flex align-items-center gap-2 mb-2">

        @if (Model.AllowOverride && Model.Accept)
        {
            <label>You can override the challenge result using this dropdown: </label>
            <select asp-for="@Model.GameChallengeResultOverride" asp-items="@Html.GetEnumSelectList<ChallengeResult>()" class="form-select w-auto" data-testid="challenge-override-select"></select>
        }
        else
        {
            if (Model.Accept)
            {
                <label>Accept the challenge: </label>
            }
            else
            {
                <label>Reject the challenge: </label>
            }
        }

        @if (Model.Accept)
        {
            <button type="submit" class="btn btn-primary" data-testid="btn-accept-challenge"><i class="fas fa-check me-1"></i>Accept Challenge</button>
        }
        else
        {
            <button type="submit" class="btn btn-danger" data-testid="btn-reject-challenge"><i class="fas fa-xmark me-1"></i>Reject Challenge</button>
        }
    </div>

</form>