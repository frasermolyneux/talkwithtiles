@using MX.TalkWithTiles.Web.Extensions
@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel

<div id="issueChallengeModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Issue Challenge</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    You can issue a challenge against <strong>@Model.LastPlayerName()</strong> for the move <strong>@Model.LastMoveAndScore()</strong>. Select the reason below and provide an (optional) message.
                </p>

                <partial name="_IssueChallengeForm" model="new IssueChallengeModel(Model.GameId)"/>
            </div>
        </div>
    </div>
</div>