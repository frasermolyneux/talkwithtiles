<div class="row">

    <div class="gameControls">
        <button id="seeControlsKey" class="btn btn-link" data-bs-toggle="modal" data-bs-target="#controlsModal" title="See an overview of the game controls" type="button">
            <i class="fas fa-circle-info"></i> Controls
        </button>
    </div>

</div>

<div id="controlsModal" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Controls</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="list-unstyled">
                    <li class="d-flex align-items-start mb-3 pb-3 border-bottom">
                        <img src="~/img/control-tilebag.PNG" alt="Tile bag button" class="me-3"/>
                        <span>If enabled in your game you can click this to see the remaining tiles.</span>
                    </li>
                    <li class="d-flex align-items-start mb-3 pb-3 border-bottom">
                        <img src="~/img/control-recalltiles.PNG" alt="Recall tiles button" class="me-3"/>
                        <span>This button will recall your tiles from the board to your rack.</span>
                    </li>
                    <li class="d-flex align-items-start mb-3 pb-3 border-bottom">
                        <img src="~/img/control-shuffle.PNG" alt="Shuffle button" class="me-3"/>
                        <span>This button will shuffle the tiles in your rack.</span>
                    </li>
                    <li class="d-flex align-items-start mb-3 pb-3 border-bottom">
                        <img src="~/img/control-skipturn.PNG" alt="Skip turn button" class="me-3"/>
                        <span>This button will skip your turn. You will be asked to confirm the action when clicking.</span>
                    </li>
                    <li class="d-flex align-items-start">
                        <img src="~/img/control-exchangetiles.PNG" alt="Exchange tiles button" class="me-3"/>
                        <span>This button will allow you to exchange tiles. You will be asked to confirm the action when clicking.</span>
                    </li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>