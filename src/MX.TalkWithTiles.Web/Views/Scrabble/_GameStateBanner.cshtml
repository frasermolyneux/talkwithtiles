@using MX.TalkWithTiles.Web.Extensions
@using MX.TalkWithTiles.Scrabble.Helpers
@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel

@if (Model.IsGameCompleted())
{
    <div class="row">

        <div class="bg-light p-5 rounded-3 text-center w-100" data-testid="game-state-banner">

            @if (Model.IsSingleWinner())
            {
                <h1 class="display-4"><i class="fas fa-trophy text-warning me-2"></i>Congratulations @Model.WinnerName()!</h1>
                <p class="lead">The winning score was @Model.WinningPoints()</p>
            }
            else
            {
                <h1 class="display-4"><i class="fas fa-handshake me-2"></i>Congratulations @Model.WinnerName()!</h1>
                <p class="lead">The result was a draw with a score of @Model.WinningPoints()</p>
            }

            <hr class="my-4"/>
            <h3>Player Score Summary</h3>
            <dl>
                @foreach (var player in Model.Players())
                {
                    <dt>
                        @player.PlayerName
                    </dt>
                    <dd class="mb-3">
                        @if (player.Tiles.Any())
                        {
                            var leftoverTilePoints = player.Tiles.Sum(t => ScrabbleTileScoreHelper.GetTileScore(t.Letter!));
                            var originalPoints = player.Score + leftoverTilePoints;

                            <text>@originalPoints - </text>

                            @foreach (var tile in player.Tiles)
                            {
                                <text><img id="@(tile.TileId)" src="/img/tiles/@(tile.Letter?.ToLowerInvariant()).jpg" alt="@(tile.Letter)" height="25" width="25" class="m-1"/></text>
                            }
                            <text> (@leftoverTilePoints) = @player.Score</text>
                        }
                        else
                        {
                            var additionalPoints = Model.Players().Where(p => p.PlayerId != player.PlayerId)
                                .Sum(p => p.Tiles.Sum(t => ScrabbleTileScoreHelper.GetTileScore(t.Letter!)));

                            var playerScore = player.Score - additionalPoints;

                            <text>@playerScore + @additionalPoints = @player.Score</text>
                        }
                    </dd>
                }
            </dl>

            <hr class="my-4"/>
            <h3>Final Turn</h3>
            <p>
                The final turn was from <strong>@Model.LastPlayerName()</strong> who placed <strong>@Model.LastMoveAndScore()</strong>
            </p>
        </div>

    </div>
}
else
{
    <div class="row">

        <div class="bg-light p-5 rounded-3 text-center w-100" data-testid="game-state-banner">
            <h1 class="display-4"><i class="fas fa-ban text-danger me-2"></i>Abandoned Game!</h1>
            <p class="lead">This game has been abandoned.</p>
        </div>

    </div>
}