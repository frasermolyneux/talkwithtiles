@using MX.TalkWithTiles.Web.Extensions
@using MX.TalkWithTiles.Contracts.Constants
@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel
@{
    ViewData["Title"] = "Play Scrabble Game";
}

@if (!Model.IsGameInProgress())
{
    <partial name="_GameStateBanner"/>
}

<partial name="_PlayerSummary"/>

<partial name="_ScrabbleBoard"/>

@if (Model.IsGameInProgress())
{
    if (Model.IsUserInGame(User))
    {
        <partial name="_ScrabbleRack"/>

        <div class="row">

            <div class="turnScore">
                <div id="turnScore" data-testid="turn-score"></div>
            </div>

        </div>
    }

    @if (Model.IsCurrentPlayer(User) && !Model.IsGameInChallenge())
    {
        <div class="row">

            <div class="gameControls" data-testid="game-controls">
                <button id="skipTurn" data-testid="btn-skip-turn" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#skipTurnModal" title="Skip your turn" type="button">
                    <i class="fas fa-forward"></i>
                </button>

                <button id="exchangeTiles" data-testid="btn-exchange-tiles" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exchangeTilesModal" title="Exchange your tiles (you will be asked for your selection)" type="button">
                    <i class="fas fa-right-left"></i>
                </button>

                <button id="submitTurn" data-testid="btn-submit-turn" class="btn btn-primary" onclick="submitPlayerMove()">Submit</button>
            </div>

        </div>
    }

    if (Model.CanIssueChallenge(User))
    {
        <div class="row">

            <div class="gameControls">
                <button id="issueChallenge" data-testid="btn-issue-challenge" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#issueChallengeModal" type="button">
                    <i class="fas fa-triangle-exclamation"></i> Challenge
                </button>
            </div>

        </div>
    }
    else if (Model.CanUndoLastTurn(User))
    {
        <div class="row">

            <div class="gameControls">
                <button id="undoLastTurn" data-testid="btn-undo-turn" class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#undoLastTurnModal" type="button">
                    <i class="fas fa-triangle-exclamation"></i> Undo Your Turn
                </button>
            </div>

        </div>
    }

    @if (Model.IsGameInChallenge() && Model.IsChallengedPlayer(User))
    {
        <partial name="_HandleChallenge"/>
    }


    @if (Model.ShowRemainingTiles(User))
    {
        <partial name="_RemainingTilesModal"/>
    }

    @if (Model.IsCurrentPlayer(User))
    {
        <partial name="_SkipTurnModal"/>
        <partial name="_ExchangeTilesModal"/>
    }

    @if (Model.IsLastPlayer(User) && !Model.IsGameInChallenge())
    {
        <partial name="_UndoLastTurnModal"/>
    }

    @if (Model.CanIssueChallenge(User))
    {
        <partial name="_IssueChallengeModal"/>
    }

    <partial name="_ControlsReadme"/>
}

@section Styles
{
    <link href="~/css/scrabble.css" rel="stylesheet" asp-append-version="true"/>
}

@section Scripts
{
    <script src="~/js/scrabble-play.js" asp-append-version="true"></script>

    @if (Model.EndGameStateModel.GameStateType == GameStateType.InProgress)
    {
        <script type="text/javascript">

            InitGameGlobals("@Model.GameId", "@User.GetUserGuid()", "@Model.CurrentPlayerId()", @Model.GameEtag);

            @foreach (var tile in Model.UserTiles(User))
            {
                <text>
                    var toAdd = {
                        tileId: "@tile.TileId.ToString()",
                        letter: "@tile.Letter",
                        rackPosition: @tile.RackPosition,
                        posX: 0,
                        posY: 0
                    };
                    userTiles.push(toAdd);
                </text>
            }
            console.log(userTiles);

            InitTileRack();
            InitBoard();
            InitSizes();
        </script>
    }
}