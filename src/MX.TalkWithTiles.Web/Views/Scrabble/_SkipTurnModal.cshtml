@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel

<div id="skipTurnModal" data-testid="modal-skip-turn" class="modal fade" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Skip Turn?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to skip your turn? you can exchange tiles if needed.
            </div>
            <div class="modal-footer">
                <form asp-controller="Scrabble" asp-action="SkipTurn" asp-antiforgery="true" method="post">
                    <input name="id" type="hidden" value="@Model.GameId"/>
                    <button type="submit" data-testid="modal-skip-turn-confirm" class="btn btn-primary"><i class="fas fa-forward me-1"></i>Confirm Skip Turn</button>
                </form>
                <button type="button" data-testid="modal-skip-turn-cancel" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>