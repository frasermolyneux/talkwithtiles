@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel

@{
    ViewBag.Title = "Abandon Game";
    Layout = "_Layout";
}

<h2>Are you sure you want to abandon the game?</h2>

<form asp-action="ConfirmAbandon" asp-antiforgery="true" asp-route-id="@Model.GameId">
    <div class="form-group">
        <input type="submit" value="Confirm" class="btn btn-danger"/>
    </div>
</form>