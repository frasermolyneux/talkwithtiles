@using Microsoft.AspNetCore.Antiforgery
@using System.Text.Json
@inject IAntiforgery Antiforgery
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var aiClientConnection = Configuration["ApplicationInsights:ClientConnectionString"];
    var aiClientConnectionJson = string.IsNullOrWhiteSpace(aiClientConnection)
        ? null
        : JsonSerializer.Serialize(aiClientConnection);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Play online Scrabble and other word games for free with friends and family supporting up to four players." />
    <meta name="keywords" content="scrabble games, free scrabble games, scrabble games online, scrabble game, scrabble solver, play scrabble game, scrabble online, play scrabble, scrabble finder">

    <title>@ViewData["Title"] - Talk With Tiles</title>

    <link rel="canonical" href="https://www.talkwithtiles.molyneux.me">
    <link rel="shortcut icon" type="image/x-icon" href="~/favicon.ico">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", false)
</head>
<body>
@{
    bool hideClutter = ViewBag.HideScreenClutter ?? false;
}
@if (!hideClutter)
{
    <header>
        <partial name="_Navigation"/>
    </header>
}


<div class="container @(hideClutter ? "" : "mt-5")">
    <div class="pt-3 pb-2">
        <alerts></alerts>
    </div>
    <main id="mainContainer" role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

@{
    var entryAssembly = System.Reflection.Assembly.GetEntryAssembly();
    var informationalVersion = entryAssembly?.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "unknown";
    var buildVersion = informationalVersion.Split('+')[0];
    var assemblyVersion = entryAssembly?.GetName().Version?.ToString() ?? "unknown";
}
@if (!hideClutter)
{
    <footer class="border-top footer text-muted">
        <div class="container">
            <span class="float-end small" title="Full: @informationalVersion&#10;Assembly: @assemblyVersion">v@(buildVersion)</span>
            <p>
                &copy; @DateTime.Now.Year - <a href="https://molyneux.io" target="_blank">Molyneux.IO</a> - A personal project - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a> - <a asp-area="" asp-controller="Home" asp-action="Cookies">Cookies Notice</a>
            </p>
            <p>
                SCRABBLE® is a registered trademark. All intellectual property rights in and to the game are owned in the U.S.A and Canada by Hasbro Inc., and throughout the rest of the world by J.W. Spear & Sons Limited of Maidenhead, Berkshire, England, a subsidiary of Mattel Inc. Mattel and Spear are not affiliated with Hasbro. Words with Friends is a trademark of Zynga with Friends.
            </p>
            <p>
                Talk With Tiles is not affiliated with SCRABBLE®, Mattel Inc, Hasbro Inc, Zynga with Friends or Zynga Inc in any way.
            </p>
        </div>
    </footer>
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

<script>
    @{
        var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context);
    }
    const antiforgeryToken = "@antiforgeryToken.RequestToken";
</script>

@if (aiClientConnectionJson is not null)
{
    <script type="text/javascript" src="https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js"></script>
    <script type="text/javascript">
        var sdkInstance = "appInsightsSDK";
        window[sdkInstance] = "appInsights";
        var aiName = window[sdkInstance];
        var aisdk = window[aiName] || (function (cfg) {
            var appInsights = {
                config: cfg,
                initialize: true,
                queue: [],
                sv: "8",
                version: 2.0
            };
            function addMethod(name) {
                appInsights[name] = function () {
                    var args = arguments;
                    appInsights.queue.push(function () { appInsights[name].apply(appInsights, args); });
                };
            }
            var methods = ["Event", "PageView", "Exception", "Trace", "DependencyData", "Metric", "PageViewPerformance"];
            while (methods.length) { addMethod("track" + methods.pop()); }
            addMethod("flush");
            addMethod("setAuthenticatedUserContext");
            addMethod("clearAuthenticatedUserContext");
            addMethod("addTelemetryInitializer");
            return appInsights;
        })({
            connectionString: @Html.Raw(aiClientConnectionJson)
        });
        window[aiName] = aisdk;
        aisdk.trackPageView({});
    </script>
}

@await RenderSectionAsync("Scripts", false)
</body>
</html>