@using MX.TalkWithTiles.Web.Extensions
<nav class="navbar fixed-top navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
    <div class="container">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Talk With Tiles</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
            <partial name="_LoginPartial"/>
            <ul class="navbar-nav flex-grow-1">

                <li class="nav-item">
                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item dropdown">
                        <a class="nav-link text-dark dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Scrabble
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="Scrabble" asp-action="Index"><i class="fas fa-rectangle-list"></i> My Games</a>
                            <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="Scrabble" asp-action="Create"><i class="fas fa-square-plus"></i> Create Game</a>
                        </div>
                    </li>
                }

                <li class="nav-item dropdown">
                    <a class="nav-link text-dark dropdown-toggle" href="#" id="aboutDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        About/Guides
                    </a>
                    <div class="dropdown-menu" aria-labelledby="aboutDropdown">
                        <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="About" asp-action="ScrabbleGames"><i class="fas fa-chess-board"></i> Scrabble Game Types</a>
                        <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="About" asp-action="GettingStarted"><i class="fas fa-circle-info"></i> Getting Started</a>
                        <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="About" asp-action="GameControls"><i class="fas fa-gamepad"></i> Game Controls</a>
                        <a class="nav-link dropdown-item text-dark" asp-area="" asp-controller="About" asp-action="Faq"><i class="fas fa-circle-question"></i> FAQ</a>
                    </div>
                </li>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Feedback">Feedback</a>
                    </li>
                }
                
                @if (User.IsAdmin())
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Analytics" asp-action="Index">Analytics</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>