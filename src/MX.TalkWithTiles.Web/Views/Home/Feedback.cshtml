@model Feedback

@{
    ViewBag.Title = "Feedback";
    Layout = "_Layout";
}

<div class="row">
    <h2>Feedback</h2>
    <p>
        Talk With Tiles is still under development and there are expected to be bugs and features missing.
        Building a successful games platform cannot be done alone and your feedback is needed and encouraged.
        To make it easy to provide feedback you can use the form below.
    </p>
    <p>
        We may contact you via email to respond to your comments or get more information.
    </p>
</div>

<div class="row">

    <form asp-action="SubmitFeedback" asp-antiforgery="true">

        <div class="form-group mb-3">
            @Html.TextAreaFor(model => model.FeedbackText, new { @class = "form-control", rows = 15, placeholder = "Provide your feedback here..." })
            @Html.ValidationMessageFor(model => model.FeedbackText, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-primary"><i class="fas fa-paper-plane me-2"></i>Submit Feedback</button>
        </div>

    </form>

</div>
