@using MX.TalkWithTiles.Web.Extensions
@model MX.TalkWithTiles.Contracts.StateModels.GameStateModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="marketing">

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="row">
            <div class="bg-light p-5 rounded-3">
                <h1 class="display-4">Welcome @User.GetUserName()!</h1>
                <p class="lead">Thanks for signing in to Talk With Tiles. You can create a game from the top menu by clicking <strong>Scrabble</strong> > <strong>Create Game</strong>.</p>
                <hr class="my-4">
                <p>Alternatively click this button to go straight there.</p>
                <p class="lead">
                    <a asp-controller="Scrabble" asp-action="Create" class="btn btn-primary btn-lg" role="button"><i class="fas fa-plus me-2"></i>Create Scrabble Game</a>
                </p>
            </div>
        </div>
    }

    <div id="carouselExampleIndicators" class="carousel slide d-none d-sm-block" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="d-block carousel-image" src="~/img/standardboard.PNG" alt="First slide">
                <div class="carousel-caption d-none d-md-block jumbotron">
                    <h5>The game you know and love</h5>
                    <p>The standard board size and tile counts that you know and love without any messing. As close to the true game as we can make it.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img class="d-block carousel-image" src="~/img/mini-game.PNG" alt="Second slide">
                <div class="carousel-caption d-none d-md-block jumbotron">
                    <h5>Introducing the mini game!</h5>
                    <p>Need to practice your tight games? short on time? Try the mini game with a 9x9 grid and half the number of tiles.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img class="d-block carousel-image" src="~/img/supersizeboard.PNG" alt="Third slide">
                <div class="carousel-caption d-none d-md-block jumbotron">
                    <h5>Lets think a little bigger</h5>
                    <p>The supersize board is a 19x19 giant that really lets you play those long words and spread out. It has double the tiles so you can fill the whole board.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <hr class="featurette-divider d-none d-sm-block">

    <div class="row">
        <div class="col-md-7">
            <h1 class="featurette-heading fw-normal">Online Scrabble. <span class="text-muted">Lets Play a Game.</span></h1>
            <p class="lead">This website was created to fill the demand of a easy, no-frills and modern way to play Scrabble (+other) board games with friends and family.</p>
            <p class="lead">We have tried to recreate the experience of in-person Scrabble as much as possible. We suggest playing whilst on a Zoom/Skype/WhatsApp/etc. video call for the best social experience.</p>
            <p class="lead">Our service allows you to play with up to four players in any of the game types.</p>
        </div>
        <div class="col-md-5">
            <img class="img-fluid mx-auto" src="~/img/home-image-1.PNG" alt="standard scrabble board"/>
        </div>
    </div>

    <hr class="featurette-divider">

    <div class="row">
        <div class="col-md-7 order-md-2">
            <h2 class="featurette-heading">Easy Controls. <span class="text-muted">See For Yourself.</span></h2>
            <p class="lead">Our easy-to-use 'drag and drop' (or 'tap and tap' for mobile/tablet) interface is quick to pick up and get playing.</p>
            <p class="lead">The controls include recalling, shuffling and exchanging tiles and skipping your turn.</p>
            <p class="lead">For when things go wrong there is a quick 'undo turn' button and also the ability to challenge a players turn.</p>
        </div>
        <div class="col-md-5">
            <img src="~/img/home-image-2.PNG" class="img-fluid mx-auto" alt="easy scrabble controls"/>
        </div>
    </div>

    <hr class="featurette-divider">

    <div class="row">
        <div class="col-md-7">
            <h2 class="featurette-heading">And lastly, this one. <span class="text-muted">Play How You Like.</span></h2>
            <p class="lead">People play in different ways with their own rules. When you create a game you decide the rules.</p>
            <p class="lead">Currently we do not have any dictionary validation and it is up to the players to decide those rules. When we do add them it will still be completely optional!</p>
            <p class="lead">When creating a game you can decide on aspects such as if players can see remaining tiles, when they can see them and the outcomes of challenges.</p>
        </div>
        <div class="col-md-5">
            <img src="~/img/home-image-3.PNG" class="img-fluid mx-auto" alt="scrabble game options"/>
        </div>
    </div>

    <hr class="featurette-divider">
</div>

@section Styles{
    <link href="~/css/home.css" rel="stylesheet"/>
}