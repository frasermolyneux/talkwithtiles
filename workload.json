{
  "schemaVersion": 1,
  "id": "talkwithtiles",
  "applicationType": "container",
  "networks": [
    {
      "name": "database",
      "internetAccess": false
    },
    {
      "name": "public-proxy",
      "internetAccess": true
    }
  ],
  "services": [
    {
      "name": "talkwithtiles-web",
      "image": "acr7ca0fd3326df.azurecr.io/workloads/talkwithtiles/web@sha256:3188273aee5ff0884aaa022e91e3f43a2e590e8dbbd528a14ff0ce39df23da85",
      "runAs": "1654:1654",
      "environment": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "TALKWITHTILES_RUNTIME_FILE": "/run/secrets/runtime-configuration"
      },
      "networks": [
        "database",
        "public-proxy"
      ],
      "mounts": [
        {
          "id": "keyring",
          "target": "/app/state/keys",
          "readOnly": false
        }
      ],
      "secrets": [
        {
          "id": "runtime-configuration",
          "target": "runtime-configuration"
        },
        {
          "id": "client-certificate",
          "target": "client-certificate"
        },
        {
          "id": "database-password",
          "target": "database-password"
        }
      ],
      "tmpfs": [
        "/tmp"
      ],
      "resources": {
        "cpus": 1,
        "memoryMb": 512,
        "pids": 128
      },
      "health": {
        "test": [
          "CMD",
          "dotnet",
          "MX.TalkWithTiles.Web.dll",
          "--healthcheck"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 3,
        "startPeriodSeconds": 60
      }
    },
    {
      "name": "talkwithtiles-postgres",
      "image": "acr7ca0fd3326df.azurecr.io/workloads/talkwithtiles/postgres@sha256:4650a73d9a0d0ebef8b5812400e8fdf71d237a23f5971bd9bc64400688ba32de",
      "runAs": "999:1654",
      "networks": [
        "database"
      ],
      "mounts": [
        {
          "id": "postgres",
          "target": "/var/lib/postgresql/data",
          "readOnly": false
        }
      ],
      "secrets": [
        {
          "id": "database-password",
          "target": "database-password"
        }
      ],
      "tmpfs": [
        "/tmp"
      ],
      "resources": {
        "cpus": 1,
        "memoryMb": 512,
        "pids": 128
      },
      "health": {
        "test": [
          "CMD",
          "pg_isready",
          "--host=127.0.0.1",
          "--username=talkwithtiles",
          "--dbname=talkwithtiles"
        ],
        "intervalSeconds": 15,
        "timeoutSeconds": 5,
        "retries": 6,
        "startPeriodSeconds": 60
      }
    }
  ],
  "ingress": [],
  "deployment": {
    "healthTimeoutSeconds": 300,
    "healthPollSeconds": 3,
    "rollbackOnFailure": true
  }
}
